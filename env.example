# Plantilla de variables de entorno — copia este archivo a .env (o .env.local)
# y pon ahí tus valores reales. Nunca subas .env con valores reales a git
# (agrégalo a .gitignore); este .env.example sí se versiona, sin secretos.

# === Azure Speech (STT + TTS) ===
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Opcional: solo si tu recurso usa un endpoint/dominio personalizado
AZURE_SPEECH_ENDPOINT=

# === Azure OpenAI (gpt-4.1-mini) ===
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Nombre del DEPLOYMENT en Azure (lo eliges tú al desplegar el modelo),
# no necesariamente el nombre del modelo
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Selector de desarrollador para comparar caminos de consulta:
#   tools (default) -> el LLM elige entre las 4 tools tipadas; el código arma el SQL
#   gpt             -> el LLM genera el SELECT de TODAS las consultas (rompe la
#                      regla 2 a propósito; solo para ver respuestas)
QUERY_MODE=tools

# === datos.gov.co (Socrata / SODA3) ===
# Dataset de referencia: "Relación de IPS públicas y privadas según el nivel
# de atención y capacidad instalada"
DATOS_GOV_DATASET_ID=s2ru-bqt6
DATOS_GOV_APP_TOKEN=
# Completa estas dos SOLO si tu token es de tipo key/secret (API Key) en vez
# de un único App Token; si solo tienes un token, deja estas dos vacías
DATOS_GOV_API_KEY_ID=
DATOS_GOV_API_KEY_SECRET=

# === Catálogo sincronizado (Supabase/Postgres) ===
# Pendiente: crear un proyecto gratis en supabase.com si aún no existe
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Varios ===
# Secreto propio para proteger el endpoint de refresco (cron) del catálogo;
# invéntalo tú, cualquier cadena larga sirve
CRON_SECRET=

# === Twilio (Telefonía - Fase 5) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
